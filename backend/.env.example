# PostgreSQL (recommended). Run `docker compose up -d db` from the repo root, or point at your own server.
DATABASE_URL=postgresql+psycopg://quality:quality@localhost:5432/quality
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://quality:quality@localhost:3306/quality
# If DATABASE_URL is unset the API falls back to a local SQLite file (dev only).
UPLOAD_DIR=./uploads
